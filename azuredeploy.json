{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "webAppName": {
      "type": "string",
      "metadata": {
        "description": "Name of the Web App to create"
      }
    },
    "hostingPlanName": {
      "type": "string",
      "defaultValue": "myMvcApp-asp-plan",
      "metadata": {
        "description": "App Service plan name"
      }
    },
    "appInsightsName": {
      "type": "string",
      "defaultValue": "myMvcApp-ai",
      "metadata": {
        "description": "Application Insights resource name"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources"
      }
    },
    "skuName": {
      "type": "string",
      "defaultValue": "F1",
      "metadata": {
        "description": "App Service plan SKU name (F1, B1, S1, etc.)"
      }
    }
  },
  "variables": {
    "hostingPlanResourceId": "[resourceId('Microsoft.Web/serverfarms', parameters('hostingPlanName'))]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2021-02-01",
      "name": "[parameters('hostingPlanName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "[parameters('skuName')]",
        "tier": "[if(equals(parameters('skuName'),'F1'),'Free', if(startsWith(parameters('skuName'),'B'),'Basic','Standard'))]",
        "capacity": 1
      },
      "properties": {
        "name": "[parameters('hostingPlanName')]",
        "reserved": false
      }
    },
    {
      "type": "microsoft.insights/components",
      "apiVersion": "2015-05-01",
      "name": "[parameters('appInsightsName')]",
      "location": "[parameters('location')]",
      "properties": {
        "Application_Type": "web"
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2021-02-01",
      "name": "[parameters('webAppName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[variables('hostingPlanResourceId')]",
        "[resourceId('microsoft.insights/components', parameters('appInsightsName'))]"
      ],
      "kind": "app",
      "properties": {
        "serverFarmId": "[variables('hostingPlanResourceId')]",
        "siteConfig": {
          "alwaysOn": true,
          "http20Enabled": true,
          "minTlsVersion": "1.2",
          "appSettings": [
            {
              "name": "ASPNETCORE_ENVIRONMENT",
              "value": "Production"
            },
            {
              "name": "APPINSIGHTS_INSTRUMENTATIONKEY",
              "value": "[reference(resourceId('microsoft.insights/components', parameters('appInsightsName')), '2015-05-01').InstrumentationKey]"
            }
          ]
        },
        "httpsOnly": true
      }
    }
  ],
  "outputs": {
    "webAppDefaultHostName": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Web/sites', parameters('webAppName')), '2018-11-01').defaultHostName]"
    },
    "appInsightsInstrumentationKey": {
      "type": "string",
      "value": "[reference(resourceId('microsoft.insights/components', parameters('appInsightsName')), '2015-05-01').InstrumentationKey]"
    }
  }
}
